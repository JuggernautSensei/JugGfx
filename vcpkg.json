{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "juggfx",
  "version-semver": "0.1.0",
  "description": "JugGfx D3D11 graphics library",
  "homepage": "https://github.com/JuggernautSensei/JugGfx",
  "builtin-baseline": "e3ed41868d5034bc608eaaa58383cd6ecdbb5ffb",
  "dependencies": [
    "cgltf",
    "parallel-hashmap",
    "sdl3",
    "stb",
    "tinyexr",
    "imguizmo",
    "spdlog",
    "shader-slang",
    {
      "name": "imgui",
      "features": [ "docking-experimental", "sdl3-binding" ]
    }
  ],
  "overrides": [
    { "name": "shader-slang", "version": "2026.18.2" }
  ]
}