prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: OpenColorIO
Version: 2.4.2
Description: OpenColorIO (OCIO) is a complete color management solution
URL: https://github.com/AcademySoftwareFoundation/OpenColorIO
Libs: "-L${libdir}" -lOpenColorIO
Cflags: "-I${includedir}"

